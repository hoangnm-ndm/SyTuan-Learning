# Tùy chọn, mặc định 3000
PORT=
# Bắt buộc: chuỗi kết nối MongoDB
DB_URI=
# Bắt buộc: secret ký access token
JWT_SECRET_AT=
# Tùy chọn, mặc định 15m
JWT_EXPIRES_IN_AT=

# Bắt buộc: secret ký refresh token (khác secret access token)
JWT_SECRET_RT=
# Tùy chọn, mặc định 7d
JWT_EXPIRES_IN_RT=
# development | production (production bật cờ secure cho cookie auth)
NODE_ENV=

# Chỉ cho `npm run seed:super-admin` (tạo/nâng tài khoản superAdmin)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
# Tùy chọn, mặc định "Super Admin"
SEED_SUPER_ADMIN_FULLNAME=
